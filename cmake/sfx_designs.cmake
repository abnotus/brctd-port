# Writes OUT, a header holding IN (data/sfx_adlib.toml: the sound lab's
# designs, the owner's own work) as a string, so the engine plays the
# approved AdLib effects without reading the repo at run time (D-0069;
# CMakeLists.txt cotd_sfx_designs).
file(READ "${IN}" text)
# Only the designs: the file's comment lines stay out of the program.
string(REGEX REPLACE "(^|\n)[ \t]*#[^\n]*" "\\1" text "${text}")
string(REGEX REPLACE "\n\n+" "\n" text "${text}")
if(text MATCHES "\\)cotd_sfx\"")
  message(FATAL_ERROR "${IN} holds the string's closing delimiter")
endif()
file(WRITE "${OUT}" "// Generated by cmake/sfx_designs.cmake from data/sfx_adlib.toml.\n#pragma once\nconstexpr const char* kBuiltInDesigns = R\"cotd_sfx(${text})cotd_sfx\";\n")
