# Writes OUT (a header with COTD_VERSION = `git describe --always --dirty`
# of SRC, after SRC/VERSION's first line when there is one) if it changed;
# run at every build (CMakeLists.txt cotd_version).
execute_process(COMMAND git describe --always --dirty
                WORKING_DIRECTORY "${SRC}"
                OUTPUT_VARIABLE v OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR v STREQUAL "")
  set(v "unknown")
endif()
# The public release's VERSION file (tools/release/VERSION, session 62):
# the version first, the commit after it.
set(num "0,0,0,0")
if(EXISTS "${SRC}/VERSION")
  file(STRINGS "${SRC}/VERSION" ver LIMIT_COUNT 1)
  set(v "${ver} (${v})")
  # The Windows resource's numbers (goal 81): 0.9.0 is 0,9,0,0.
  if(ver MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)")
    set(num "${CMAKE_MATCH_1},${CMAKE_MATCH_2},${CMAKE_MATCH_3},0")
  endif()
endif()
set(text "// Generated by cmake/version.cmake.\n#pragma once\n#define COTD_VERSION \"${v}\"\n")
# cmake/cotd.rc's copy: no #pragma (windres's preprocessor).
set(rc "// Generated by cmake/version.cmake.\n#define COTD_VERSION \"${v}\"\n#define COTD_VERSION_NUM ${num}\n")
string(REPLACE "version.hpp" "version_rc.h" rc_out "${OUT}")
if(EXISTS "${rc_out}")
  file(READ "${rc_out}" old_rc)
else()
  set(old_rc "")
endif()
if(NOT old_rc STREQUAL rc)
  file(WRITE "${rc_out}" "${rc}")
endif()
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
else()
  set(old "")
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
