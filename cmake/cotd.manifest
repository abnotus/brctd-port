<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- cotd.exe's application manifest (cmake/cotd.rc): the process code page
     is UTF-8 (Windows 10 1903 and later), so the command line and every
     narrow file name the engine passes to the C runtime are UTF-8, as on
     Linux: a game folder with non-ASCII letters works (session 72, M2). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="cotd" version="1.0.0.0"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
