# Writes OUT, a header holding IN (data/cotd.dat: the Log Book's sealed
# text, CLAUDE.md hard rule 1's one exception) as bytes, so the engine
# carries it without reading the repo at run time (D-0083; CMakeLists.txt
# cotd_sealed_text). A missing IN gives an empty array.
if(EXISTS "${IN}")
  file(READ "${IN}" hex HEX)
else()
  set(hex "")
endif()
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(LENGTH "${hex}" n)
math(EXPR n "${n} / 2")
file(WRITE "${OUT}" "// Generated by cmake/sealed_text.cmake from data/cotd.dat.\n#pragma once\n#include <cstddef>\ninline constexpr std::size_t kSealedSize = ${n};\ninline constexpr unsigned char kSealed[${n} + 1] = {${bytes}0};\n")
