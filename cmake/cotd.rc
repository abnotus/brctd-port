// SPDX-License-Identifier: GPL-3.0-or-later
// ctd.exe's resources: its application manifest (1 RT_MANIFEST) and, since
// goal 81, its version information (Properties, Details).
#include <winver.h>
#include "version_rc.h"

1 24 "cotd.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION COTD_VERSION_NUM
PRODUCTVERSION COTD_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "ctd, a native engine for Countdown to Doomsday"
      VALUE "FileVersion", COTD_VERSION
      VALUE "ProductName", "ctd"
      VALUE "ProductVersion", COTD_VERSION
      VALUE "LegalCopyright", "Copyright (C) 2026 Abnotus. GPL-3.0-or-later"
      VALUE "OriginalFilename", "ctd.exe"
      VALUE "InternalName", "ctd"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
